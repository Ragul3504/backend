# ─────────────────────────────────────────────────────────────
#  Electryonz 2026 – Environment Variables
#  File: .env.local  (for local dev)
#  For Vercel: add each key in Dashboard → Settings → Environment Variables
#  ⚠️  NEVER commit this file to GitHub
# ─────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════
#  SUPABASE
#  Where to find: supabase.com → Your Project → Settings → API
# ══════════════════════════════════════════════════════════════

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://wujcykktrgkzmguoipzt.supabase.co

# Service Role Key  (NOT the anon key — this bypasses Row Level Security)
# Starts with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_TfnRppI1P79OE9kUfZXq9g_FnYQHAIN


# ══════════════════════════════════════════════════════════════
#  NODEMAILER — Gmail SMTP
#  HOW TO GET APP PASSWORD (do this once):
#    1. Login to altranz2026@gmail.com
#    2. myaccount.google.com → Security → 2-Step Verification → ON
#    3. Search "App Passwords" → App name: Electryonz Mailer → Create
#    4. Copy the 16-char password shown (spaces are fine to keep)
# ══════════════════════════════════════════════════════════════

SMTP_USER=altranz2026@gmail.com
SMTP_PASS=tvdf wofc hbiz xgam


# ══════════════════════════════════════════════════════════════
#  UPI / GOOGLE PAY
#  Your UPI ID to receive payments
#  Find it: Google Pay app → Profile photo → your UPI ID is shown below your name
#  Common formats: name@okicici | name@oksbi | name@ybl | phonenumber@paytm
# ══════════════════════════════════════════════════════════════

UPI_ID=ragulas3504@oksbi


# ══════════════════════════════════════════════════════════════
#  ADMIN SECRET
#  Protects GET /api/registrations endpoint
#  Use any strong random string — keep it secret
#  Generate one: https://passwordsgenerator.net/  or just type something random
# ══════════════════════════════════════════════════════════════

ADMIN_SECRET=electryonz_admin_2026_super_secret


# ══════════════════════════════════════════════════════════════
#  FRONTEND URL  (for CORS — set AFTER deploying frontend)
#  Your Vercel frontend URL  e.g. https://electryonz.vercel.app
#  Use * during development (allows all origins)
# ══════════════════════════════════════════════════════════════

FRONTEND_URL=https://electryonz-frontend1.vercel.app/
